{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paradigma.local/analista/esquema/comparacion-corpus-fase11-v1.0.0.schema.json",
  "title": "Salida especializada de comparación del corpus - Fase 11 v1.0.0",
  "description": "Contrato para reunir registros procedentes exclusivamente de maestros auditados de obra. Las claves interobra son claves de recuperación documental y nunca establecen identidad, equivalencia, complementariedad ni contradicción doctrinal.",
  "type": "object",
  "required": [
    "id",
    "tipo_registro",
    "schema_version",
    "motor",
    "version_motor",
    "fuente_exclusiva",
    "maestros",
    "clausura_descriptiva",
    "cobertura",
    "grupos"
  ],
  "properties": {
    "id": {"type": "string", "pattern": "^F11OUT-[0-9A-F]{12}$"},
    "tipo_registro": {"const": "salida_comparacion_corpus"},
    "schema_version": {"const": "1.0.0"},
    "motor": {
      "enum": [
        "conceptos_corpus",
        "definiciones_corpus",
        "afirmaciones_corpus",
        "formulas_corpus",
        "relaciones_explicitas_corpus",
        "negaciones_excepciones_corpus",
        "variantes_terminologicas_corpus",
        "distribucion_por_obra",
        "orden_recurrencia"
      ]
    },
    "version_motor": {"const": "1.0.0"},
    "fuente_exclusiva": {"const": "json_maestros_obra_auditados"},
    "maestros": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["obra_id", "titulo", "schema_version", "sha256"],
        "properties": {
          "obra_id": {"type": "string", "minLength": 1},
          "titulo": {"type": "string", "minLength": 1},
          "schema_version": {"enum": ["1.1.0", "1.4.1"]},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        },
        "additionalProperties": false
      }
    },
    "clausura_descriptiva": {
      "type": "object",
      "required": [
        "solo_maestros_obra",
        "identidad_interobra_inferida",
        "equivalencia_inferida",
        "complementariedad_inferida",
        "contradiccion_inferida",
        "sintesis_doctrinal",
        "resolucion_doctrinal"
      ],
      "properties": {
        "solo_maestros_obra": {"const": true},
        "identidad_interobra_inferida": {"const": false},
        "equivalencia_inferida": {"const": false},
        "complementariedad_inferida": {"const": false},
        "contradiccion_inferida": {"const": false},
        "sintesis_doctrinal": {"const": false},
        "resolucion_doctrinal": {"const": "no_realizada"}
      },
      "additionalProperties": false
    },
    "cobertura": {
      "type": "object",
      "required": ["obras_totales", "obras_procesadas", "registros_origen", "grupos_emitidos"],
      "properties": {
        "obras_totales": {"type": "integer", "minimum": 1},
        "obras_procesadas": {"type": "integer", "minimum": 1},
        "registros_origen": {"type": "integer", "minimum": 0},
        "grupos_emitidos": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "grupos": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "clave_recuperacion",
          "criterio_agrupacion",
          "estado_identidad_interobra",
          "equivalencia_inferida",
          "complementariedad_inferida",
          "contradiccion_inferida",
          "resolucion_doctrinal",
          "obra_ids",
          "registros"
        ],
        "properties": {
          "id": {"type": "string", "pattern": "^F11G-[0-9A-F]{12}$"},
          "clave_recuperacion": {"type": "string"},
          "criterio_agrupacion": {"type": "string", "minLength": 1},
          "estado_identidad_interobra": {"enum": ["no_determinada", "no_aplica"]},
          "equivalencia_inferida": {"const": false},
          "complementariedad_inferida": {"const": false},
          "contradiccion_inferida": {"const": false},
          "resolucion_doctrinal": {"const": "no_realizada"},
          "obra_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "registros": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "obra_id",
                "titulo_obra",
                "schema_maestro",
                "registro_id",
                "tipo_registro_origen",
                "estado_extraccion",
                "estado_verificacion",
                "estado_auditoria",
                "texto_literal",
                "normalizacion_formal",
                "normalizacion_lexica",
                "datos_documentales"
              ],
              "properties": {
                "obra_id": {"type": "string", "minLength": 1},
                "titulo_obra": {"type": "string", "minLength": 1},
                "schema_maestro": {"enum": ["1.1.0", "1.4.1"]},
                "registro_id": {"type": "string", "minLength": 1},
                "tipo_registro_origen": {"type": "string", "minLength": 1},
                "estado_extraccion": {"type": ["string", "null"]},
                "estado_verificacion": {"type": ["string", "null"]},
                "estado_auditoria": {"type": ["string", "null"]},
                "estatus_enunciativo": {"type": ["string", "null"]},
                "fuente_id": {"type": ["string", "null"]},
                "unidad_id": {"type": ["string", "null"]},
                "localizacion": {"type": ["object", "null"]},
                "texto_literal": {"type": ["string", "null"]},
                "normalizacion_formal": {"type": ["string", "null"]},
                "normalizacion_lexica": {
                  "type": ["array", "null"],
                  "items": {"type": "string"}
                },
                "datos_documentales": {"type": "object"}
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
