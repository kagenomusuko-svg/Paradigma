{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://paradigma.local/analista/esquema/maestro-corpus-fase13-v1.0.0.schema.json",
  "title":"JSON maestro del corpus - Fase 13 v1.0.0",
  "type":"object",
  "required":["id","tipo_registro","schema_version","fase","fuente_exclusiva","origen_fase12","origen_fase11","origen_fase10","obras","productos","criterios_vinculo","clausura_descriptiva","estado_auditoria"],
  "properties":{
    "id":{"type":"string","pattern":"^F13M-[0-9A-F]{12}$"},
    "tipo_registro":{"const":"expediente_maestro_corpus"},
    "schema_version":{"const":"1.0.0"},
    "fase":{"const":13},
    "fuente_exclusiva":{"const":"expedientes_fase12_y_registros_auditados_de_origen"},
    "origen_fase12":{"type":"object"},
    "origen_fase11":{"type":"object"},
    "origen_fase10":{"type":"object"},
    "obras":{"type":"array","minItems":20,"maxItems":20,"items":{"type":"object"}},
    "productos":{
      "type":"object","required":["conceptos","formulas","restricciones"],
      "properties":{
        "conceptos":{"$ref":"#/$defs/producto"},
        "formulas":{"allOf":[{"$ref":"#/$defs/producto"},{"type":"object","required":["vinculos_recuperacion_conceptual"],"properties":{"vinculos_recuperacion_conceptual":{"type":"integer","minimum":0}}}]},
        "restricciones":{"$ref":"#/$defs/producto"}
      },
      "additionalProperties":false
    },
    "criterios_vinculo":{
      "type":"object","required":["conceptos","formulas","restricciones"],
      "properties":{
        "conceptos":{"const":"clave_documental_fase11_auditada_por_fase12"},
        "formulas":{"const":"coocurrencia_en_unidad_documentada_solo_para_recuperacion"},
        "restricciones":{"const":"afirmacion_limitada_id_documentado"}
      },
      "additionalProperties":false
    },
    "clausura_descriptiva":{
      "type":"object",
      "required":["identidad_interobra_inferida","equivalencia_inferida","complementariedad_inferida","contradiccion_inferida","sintesis_doctrinal","reconciliacion_interobra","evolucion_doctrinal_inferida","definicion_preferida","formula_concepto_inferida","resolucion_doctrinal"],
      "properties":{
        "identidad_interobra_inferida":{"const":false},
        "equivalencia_inferida":{"const":false},
        "complementariedad_inferida":{"const":false},
        "contradiccion_inferida":{"const":false},
        "sintesis_doctrinal":{"const":false},
        "reconciliacion_interobra":{"const":false},
        "evolucion_doctrinal_inferida":{"const":false},
        "definicion_preferida":{"const":false},
        "formula_concepto_inferida":{"const":false},
        "resolucion_doctrinal":{"const":"no_realizada"}
      },
      "additionalProperties":false
    },
    "estado_auditoria":{"const":"auditado"}
  },
  "$defs":{
    "producto":{
      "type":"object","required":["ruta","sha256","registros"],
      "properties":{
        "ruta":{"type":"string","minLength":1},
        "sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
        "registros":{"type":"integer","minimum":0}
      }
    }
  },
  "additionalProperties":false
}
