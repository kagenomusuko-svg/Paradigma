{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paradigma.local/analista/calibracion/patron-oro-v1.0.0.schema.json",
  "title": "Registro manual de patrón de oro — Fase 8",
  "type": "object",
  "required": ["version", "obra_id", "unidad_id", "motor", "estrato", "revision_manual", "items_esperados", "observacion"],
  "properties": {
    "version": {"const": "1.0.0"},
    "obra_id": {"const": "AA-SP-V1"},
    "unidad_id": {"type": "string", "minLength": 1},
    "motor": {"enum": ["conceptos_apariciones", "definiciones", "afirmaciones", "formulas", "relaciones_explicitas", "limitadores"]},
    "estrato": {"enum": ["general", "desafio"]},
    "revision_manual": {"const": true},
    "items_esperados": {
      "type": "array",
      "items": {"$ref": "#/$defs/item"}
    },
    "observacion": {"type": ["string", "null"]}
  },
  "additionalProperties": false,
  "$defs": {
    "item": {
      "type": "object",
      "required": ["tipo_registro", "texto_literal", "linea_inicio", "linea_fin", "clasificacion", "estatus_enunciativo", "concepto_designacion", "sujeto_designacion", "objeto_designacion", "termino_a_literal", "termino_b_literal", "objeto_negado_literal", "fragmento_literal"],
      "properties": {
        "tipo_registro": {"enum": ["aparicion_conceptual", "concepto", "definicion", "afirmacion", "formula", "relacion_explicita", "distincion", "negacion", "excepcion", "restriccion_alcance"]},
        "texto_literal": {"type": "string"},
        "linea_inicio": {"type": "integer", "minimum": 1},
        "linea_fin": {"type": "integer", "minimum": 1},
        "clasificacion": {"type": ["string", "null"]},
        "estatus_enunciativo": {"type": ["string", "null"]},
        "concepto_designacion": {"type": ["string", "null"]},
        "sujeto_designacion": {"type": ["string", "null"]},
        "objeto_designacion": {"type": ["string", "null"]},
        "termino_a_literal": {"type": ["string", "null"]},
        "termino_b_literal": {"type": ["string", "null"]},
        "objeto_negado_literal": {"type": ["string", "null"]},
        "fragmento_literal": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    }
  }
}
