{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://meriadock.org.mx/paradigma/analisis/registro-v0.1.schema.json",
  "title": "Registro analítico Paradigma v0.1",
  "description": "Contrato mínimo de procedencia. La capa generada no puede autoaprobar inferencias, equivalencias ni contradicciones.",
  "type": "object",
  "required": ["id", "tipo_registro"],
  "properties": {
    "id": {"type": "string", "minLength": 3},
    "tipo_registro": {
      "enum": [
        "concepto",
        "definicion",
        "afirmacion_candidata",
        "tesis",
        "argumento",
        "relacion",
        "inferencia",
        "equivalencia",
        "tension",
        "anomalia_editorial",
        "formula_candidata"
      ]
    },
    "estatus_epistemico": {
      "enum": ["explicita", "reconstruida", "inferida", "candidata_explicita", "no_determinado"]
    },
    "verificacion": {"enum": ["pendiente", "aprobada", "rechazada", "reclasificada"]},
    "fuente_id": {"type": "string"},
    "unidad_id": {"type": ["string", "null"]},
    "texto_fuente": {"type": ["string", "null"]},
    "contenido_normalizado": {"type": ["string", "null"]},
    "premisas": {"type": "array", "items": {"type": "string"}},
    "regla_aplicada": {"type": ["string", "null"]},
    "texto_literal_equivalente": {"type": ["string", "null"]},
    "confianza_extraccion": {"type": "number", "minimum": 0, "maximum": 1}
  },
  "allOf": [
    {
      "if": {"properties": {"tipo_registro": {"const": "inferencia"}}},
      "then": {
        "required": ["premisas", "regla_aplicada"],
        "properties": {"premisas": {"minItems": 1}}
      }
    }
  ],
  "additionalProperties": true
}
