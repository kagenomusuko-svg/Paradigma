{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paradigma.local/mapa/esquema-f1.schema.json",
  "title": "Esquema F1 del mapa maestro de Paradigma",
  "description": "Contrato estructural mínimo. La integridad referencial y las invariantes semánticas se validan en scripts/validar_mapa.py.",
  "type": "object",
  "required": [
    "map_version",
    "schema_status",
    "phase",
    "works",
    "evidence",
    "nodes",
    "relations",
    "routes",
    "review_queue",
    "tests"
  ],
  "properties": {
    "map_version": {"type": "string", "minLength": 1},
    "schema_status": {"enum": ["draft", "frozen"]},
    "phase": {"enum": ["F1", "F2", "F3", "F4", "F5", "MANT"]},
    "purpose": {"type": "string"},
    "scope_note": {"type": "string"},
    "works": {"type": "array", "items": {"$ref": "#/$defs/identified"}},
    "evidence": {"type": "array", "items": {"$ref": "#/$defs/identified"}},
    "nodes": {"type": "array", "items": {"$ref": "#/$defs/identified"}},
    "relations": {"type": "array", "items": {"$ref": "#/$defs/identified"}},
    "routes": {"type": "array", "items": {"$ref": "#/$defs/identified"}},
    "review_queue": {"type": "array", "items": {"$ref": "#/$defs/identified"}},
    "tests": {"type": "array", "items": {"$ref": "#/$defs/identified"}}
  },
  "$defs": {
    "identified": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
